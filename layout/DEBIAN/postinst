#!/bin/bash
echo "[VibeTendies] postinst: converting plists to binary..."

# Конвертируем фильтр твика
for P in /var/jb/Library/MobileSubstrate/DynamicLibraries/VibeTendies.plist \
         /var/jb/usr/lib/TweakInject/VibeTendies.plist; do
    if [ -f "$P" ]; then
        /var/jb/usr/bin/plistutil -i "$P" -o "$P.bin" -f bin 2>/dev/null && mv "$P.bin" "$P"
    fi
done

# Конвертируем PreferenceLoader plist
P2=/var/jb/Library/PreferenceLoader/Preferences/VibeTendiesPrefs.plist
if [ -f "$P2" ]; then
    /var/jb/usr/bin/plistutil -i "$P2" -o "$P2.bin" -f bin 2>/dev/null && mv "$P2.bin" "$P2"
fi

echo "[VibeTendies] Done."
exit 0
