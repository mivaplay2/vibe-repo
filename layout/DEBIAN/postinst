#!/bin/bash

# Конвертируем plist в binary (нужно для ElleKit)
for P in /var/jb/Library/MobileSubstrate/DynamicLibraries/VibeTendies.plist \
         /var/jb/usr/lib/TweakInject/VibeTendies.plist \
         /var/jb/Library/PreferenceLoader/Preferences/VibeTendiesPrefs.plist; do
    if [ -f "$P" ]; then
        /var/jb/usr/bin/plistutil -i "$P" -o "$P.bin" -f bin 2>/dev/null && mv "$P.bin" "$P"
    fi
done

# Даём права на папку и картинку
mkdir -p "/var/mobile/Library/Application Support/VibeTendies"
chown -R mobile:mobile "/var/mobile/Library/Application Support/VibeTendies" 2>/dev/null
chmod 755 "/var/mobile/Library/Application Support/VibeTendies"
chmod 644 "/var/mobile/Library/Application Support/VibeTendies/wallpaper.png" 2>/dev/null

exit 0
